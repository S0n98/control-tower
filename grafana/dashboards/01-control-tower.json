{
  "title": "Data Platform Control Tower",
  "uid": "control-tower-l1",
  "tags": [
    "pipeline",
    "control-tower",
    "l1"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "PLATFORM",
      "description": "Combined health across blackbox-probed service UIs (NiFi/Airflow/Trino/MinIO/Nessie/Ranger/Control Tower) AND every node_exporter instance (all cluster nodes) - both conditions must be up for 100%. 100% = HEALTHY, 90-99% = WARNING, below 90% = UNHEALTHY.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(sum(probe_success) + sum(up{job=\"node-exporter\"})) / (count(probe_success) + count(up{job=\"node-exporter\"})) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "100": {
                  "text": "HEALTHY"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 90,
                "to": 99.999,
                "result": {
                  "text": "WARNING"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 89.999,
                "result": {
                  "text": "UNHEALTHY"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "textMode": "value"
      },
      "links": [
        {
          "title": "Data Platform Services",
          "url": "/d/data-platform-services",
          "targetBlank": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "PIPELINES",
      "description": "Success rate over the last 24h (successful / (successful+failed) pipeline_run rows).",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "control-tower-postgres"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT CASE WHEN count(*) FILTER (WHERE status IN ('success','failed')) = 0 THEN 100.0 ELSE round(100.0 * count(*) FILTER (WHERE status = 'success') / count(*) FILTER (WHERE status IN ('success','failed')), 1) END AS success_rate FROM pipeline_run WHERE started_at > now() - interval '24 hours'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 98
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "textMode": "value"
      },
      "links": [
        {
          "title": "Pipeline Overview",
          "url": "/d/pipeline-overview",
          "targetBlank": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "DATA",
      "description": "DQ Tier-A check pass rate over the last 24h.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 10,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "control-tower-postgres"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT CASE WHEN count(*) = 0 THEN 100.0 ELSE round(100.0 * count(*) FILTER (WHERE status = 'pass') / count(*), 1) END AS dq_pass_rate FROM dq_result WHERE evaluated_at > now() - interval '24 hours'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 98
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "textMode": "value"
      },
      "links": [
        {
          "title": "Data Quality Overview",
          "url": "/d/dq-overview",
          "targetBlank": false
        }
      ]
    },
    {
      "type": "stat",
