  "panels": [
    {
      "type": "text",
      "title": "Scope note",
      "description": "Explains why Trino/MinIO/Nessie/Ranger only show blackbox probe health here, not native service metrics.",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Trino, MinIO, Nessie and Ranger are all real, running services in this environment, but none expose Prometheus metrics out of the box in their current config: **Trino** needs a JMX exporter sidecar; **MinIO** needs `MINIO_PROMETHEUS_AUTH_TYPE=public` set on its Operator-managed Tenant CRD (a plain StatefulSet env patch gets reconciled away by minio-operator - tried, reverted); **Nessie**'s `/q/metrics` Quarkus extension isn't bundled in this image. Health here is therefore the same blackbox HTTP probe used on the L1 tiles, not deep native metrics - that's a real follow-up, not simulated data."
      }
    },
    {
      "type": "stat",
      "title": "Trino",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "probe_success{instance=~\".*trino.*\"}"
        }
      ],
      "description": "No NodePort exposed for Trino's UI in this environment - ClusterIP only, reachable in-cluster at trino.default.svc.cluster.local:8080.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "HEALTHY",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
