# Copy to offline.env (next to the bundle, or in the directory you run from) and edit.
# Every value shown is the default.

# kubectl/helm context to install into (empty = current context)
KUBE_CONTEXT=""
NAMESPACE="monitoring"

# Must already exist: kubectl get storageclass
STORAGE_CLASS="nfs-client"

GRAFANA_ADMIN_PASSWORD="PipelineObs2026!"

# Email. Keep MailHog for testing, or set USE_MAILHOG=false and point at your relay.
USE_MAILHOG="true"
SMTP_SMARTHOST="mailhog.monitoring.svc.cluster.local:1025"
MAIL_DOMAIN="company.internal"        # alerts go to <owner>@MAIL_DOMAIN

# NiFi collector: auto = enable if the namespace exists. Needs the NiFi admin password.
ENABLE_NIFI="auto"
NIFI_NAMESPACE="nifi"
NIFI_POD="nifi-0"
NIFI_USER="admin"
NIFI_PASSWORD=""

# DQ Tier-A DAGs on Airflow: auto = enable if the namespace exists.
ENABLE_DQ="auto"
AIRFLOW_NAMESPACE="airflow"
AIRFLOW_DAGS_DIR="/opt/airflow/dags"
AIRFLOW_IMAGE="docker.io/library/airflow-control-tower:3.2.2"

# PodMonitors/ServiceMonitors for NiFi/Spark/Flink/Airflow (L2 dashboards)
ENABLE_ENGINE_MONITORS="true"

# Builder only: where `prepare` writes the bundle (creates <OUT_DIR>.tar.gz too)
OUT_DIR="/root/monitor-offline"
